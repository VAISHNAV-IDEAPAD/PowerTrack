# PowerTrack Root .gitignore

# Dependencies
node_modules/
package-lock.json

# Environment variables
.env
.env.local
.env.*.local

# Databases & Runtime storage
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
backend/data/*.sqlite

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Standalone build artifacts
android-standalone/build_output/
*.idsig

# Android Studio & Gradle
.gradle/
build/
app/build/
android-app/app/build/
android-app/.gradle/
android-app/build/
local.properties
.idea/
*.iml
*.iws
*.ipr
.cxx/
captures/
.externalNativeBuild

# OS files
Thumbs.db
.DS_Store
*.swp
