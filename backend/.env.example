# PowerTrack Server Environment Configuration

# Server Port
PORT=5000

# Node Environment ('development', 'production', 'test')
NODE_ENV=development

# JWT Secret Key (Replace with a secure random key in production)
JWT_SECRET=powertrack_dev_secret_key_change_in_production_2026

# JWT Expiration Time (e.g. '7d', '24h')
JWT_EXPIRES_IN=7d

# Database Path (for SQLite)
DB_PATH=./data/powertrack.sqlite

# Location Data Retention Policy (days to retain location records, 0 = unlimited)
LOCATION_RETENTION_DAYS=90

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Allowed CORS Origins (comma separated or * for dev)
CORS_ORIGIN=*

# Heartbeat & Stale Thresholds (in seconds)
DEVICE_OFFLINE_THRESHOLD_SECONDS=300
LOCATION_STALE_THRESHOLD_SECONDS=900
